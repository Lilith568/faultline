# Copy this file to .env and paste your Meta Model API key. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3 is fast and cheap; muse-wonder-1.0 is Meta's most capable model.
META_MODEL=muse-spark-1.3
# none | minimal | low | medium | high | xhigh
META_REASONING_EFFORT=medium
# Faultline only tests localhost by default. Set to 1 only for staging sites you own.
FAULTLINE_ALLOW_REMOTE=0

# Optional: use a Meta open-weight deployment instead of the hosted Meta Model API.
# This does not call the OpenAI service. See docs/MODELS.md before enabling it.
FAULTLINE_MODEL_BACKEND=meta
META_OPEN_BASE_URL=http://127.0.0.1:11434/v1
META_OPEN_MODEL=muse-glimmer
# Separate credentials: MODEL_API_KEY is never sent to this endpoint.
META_OPEN_API_KEY=
META_OPEN_REASONING_EFFORT=
# Set 1 only when the selected deployment supports image input.
META_OPEN_VISION=0
# json_schema is preferred; json_object includes the schema in the system message.
META_OPEN_JSON_MODE=json_schema

# Copy this file to .env and paste your Meta Model API key. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3 is fast and cheap; muse-wonder-1.0 is Meta's most capable model.
META_MODEL=muse-spark-1.3
# none | minimal | low | medium | high | xhigh
META_REASONING_EFFORT=medium
# Faultline only tests localhost by default. Set to 1 only for staging sites you own.
FAULTLINE_ALLOW_REMOTE=0
